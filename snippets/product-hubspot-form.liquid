{% comment %}
  Product-page block wrapper for the HubSpot form popup. The button and popup
  themselves live in snippets/hubspot-form-popup.liquid, shared with the
  "HubSpot form" section.

  Accepts:
  - block, product, block_style.
{% endcomment %}

{%- if block.settings.portal_id != blank and block.settings.form_id != blank -%}
  <div class="product__block product__block--buttons block-padding" {{ block_style }} {{ block.shopify_attributes }}>
    {%- render 'hubspot-form-popup', hs: block.settings, uid: block.id, product: product -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="product__block block-padding" {{ block_style }} {{ block.shopify_attributes }}>
    <p>HubSpot form: add your Portal ID and Form ID in this block's settings.</p>
  </div>
{%- endif -%}
