{%- liquid
  assign text_color = section.settings.color
  assign bg_color = section.settings.bg_color
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign sub_collections = linklists[collection.handle].links
  assign sub_collection_html = ''
  assign sub_collection_counter = 0
  assign sub_collection_limit = 6
  assign card_style = section.settings.card_style | default: 'overlay'
  assign tabs_align = section.settings.tabs_alignment | default: 'left'
  assign is_minimal = false
  assign is_text = false
  if card_style == 'minimal'
    assign is_minimal = true
  elsif card_style == 'text'
    assign is_text = true
  endif
-%}

{%- if linklists[collection.handle].links.size > 0 -%}
  {%- style -%}
    #Subcollections--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;
      --subcard-max: {{ section.settings.card_max_width | default: 220 }}px;
      --subcard-gap: {{ section.settings.card_gap | default: 28 }}px;
      --subcard-title-size: {{ section.settings.title_size | default: 14 }}px;

      {%- unless text_color == 'rgba(0,0,0,0)' or text_color == blank -%}
        --text: {{ text_color }};
      {%- endunless -%}

      {%- unless bg_color == 'rgba(0,0,0,0)' or bg_color == blank -%}
        --bg: {{ bg_color }};
      {%- endunless -%}
    }

    {%- if is_minimal -%}
      /* Minimal card style: square image, centered title below, no overlay. */
      .subcollections--minimal .grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--subcard-gap, 28px);
      }
      .subcollections--minimal .grid-item.subcollection__item {
        position: relative;
        height: auto;
        flex: 0 0 auto;
        width: var(--subcard-max, 220px);
        max-width: var(--subcard-max, 220px);
        overflow: visible;
      }
      .subcollections--minimal .subcollection__inner {
        height: auto;
      }
      .subcollections--minimal .subcollection__link {
        position: static;
        display: block;
        padding: 0;
        height: auto;
      }
      .subcollections--minimal .subcollection__image {
        position: relative;
        transform: none;
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 10px;
        overflow: hidden;
        transition: background-color 0.2s ease;
      }
      .subcollections--minimal .subcollection__link:hover .subcollection__image {
        transform: none;
        background-color: rgba(0, 0, 0, 0.06);
      }
      .subcollections--minimal .subcollection__image .image-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }
      .subcollections--minimal .subcollection__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .subcollections--minimal .subcollection__text {
        position: static;
        padding: 14px 4px 0;
        text-align: center;
      }
      .subcollections--minimal .subcollection__title {
        margin: 0;
        font-family: var(--FONT-STACK-SUBHEADING, inherit);
        font-weight: var(--FONT-WEIGHT-SUBHEADING, 400);
        font-size: var(--subcard-title-size, 14px);
        letter-spacing: var(--LETTER-SPACING-SUBHEADING, 0.1em);
        text-transform: uppercase;
      }
      @media (max-width: 749px) {
        .subcollections--minimal .grid {
          flex-wrap: nowrap;
          justify-content: flex-start;
          overflow-x: auto;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }
        .subcollections--minimal .grid::-webkit-scrollbar {
          display: none;
        }
        .subcollections--minimal .grid-item.subcollection__item {
          width: 160px;
        }
      }
    {%- endif -%}

    {%- if is_text -%}
      /* Text tabs style: no images, just links; active one underlined.
         Single-line horizontal scroller at every breakpoint. Padding lives on
         the scroller itself so the first/last tab clear the section edges at
         both ends of the scroll, matching the .grid-outer padding the product
         grid uses. */
      .subcollections--text .subcollections__tabs {
        display: flex;
        flex-wrap: nowrap;
        align-items: baseline;
        justify-content: flex-start;
        gap: var(--subcard-gap, 28px);
        padding-inline: var(--outer, 20px);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        -ms-overflow-style: none;
        -webkit-overflow-scrolling: touch;
      }
      .subcollections--text .subcollections__tabs::-webkit-scrollbar {
        display: none;
      }
      {%- if tabs_align == 'center' -%}
        /* `width: fit-content` + auto margins centre the row while it fits,
           then it falls back to left-aligned scrolling once it overflows —
           centring an overflowing scroller would strand the first tabs. */
        .subcollections--text .subcollections__tabs {
          width: fit-content;
          max-width: 100%;
          margin-inline: auto;
        }
      {%- endif -%}
      .subcollections--text .subcollections__tab {
        position: relative;
        color: var(--text-color, currentColor);
        text-decoration: none;
        font-family: var(--FONT-STACK-SUBHEADING, inherit);
        font-weight: var(--FONT-WEIGHT-SUBHEADING, 400);
        font-size: var(--subcard-title-size, 15px);
        letter-spacing: var(--LETTER-SPACING-SUBHEADING, 0.06em);
        white-space: nowrap;
        opacity: 0.55;
        transition: opacity 0.2s ease;
      }
      .subcollections--text .subcollections__tab:hover {
        opacity: 0.9;
      }
      .subcollections--text .subcollections__tab.is-active {
        opacity: 1;
        text-decoration: underline;
        text-underline-offset: 5px;
      }
      .subcollections--text .subcollections__count {
        font-size: 0.62em;
        margin-left: 3px;
        opacity: 0.7;
      }
      @media (max-width: 749px) {
        .subcollections--text .subcollections__tabs {
          gap: 22px;
        }
      }
    {%- endif -%}
  {%- endstyle -%}

{%- render 'stylesheet', name: 'subcollections.css', inline: true -%}

  <section
    class="subcollections{% if is_minimal %} subcollections--minimal{% endif %}{% if is_text %} subcollections--text{% endif %} collection-{{ collection.handle }} section-padding {{ color_scheme }}"
    id="Subcollections--{{ section.id }}"
  >
    {%- if is_text -%}
      {%- if sub_collections.size > 0 -%}
        <nav class="subcollections__tabs" aria-label="Subcollections">
          {%- if section.settings.text_all_collection != blank -%}
            {%- assign all_col = section.settings.text_all_collection -%}
            <a
              class="subcollections__tab{% if collection.handle == all_col.handle %} is-active{% endif %}"
              href="{{ all_col.url }}"
            >
              {{- section.settings.text_all_label | default: 'All' -}}
              {%- if section.settings.text_show_count and collection.handle == all_col.handle -%}
                <sup class="subcollections__count">{{ all_col.all_products_count }}</sup>
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- for sublink in sub_collections -%}
            {%- liquid
              if sublink.type != 'collection_link' or sublink.object.handle == blank
                continue
              endif
              assign sc = collections[sublink.object.handle]
              if sc == blank
                continue
              endif
              assign is_active = false
              if sc.handle == collection.handle
                assign is_active = true
              endif
            -%}
            <a
              class="subcollections__tab{% if is_active %} is-active{% endif %}"
              href="{{ sc.url }}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{- sc.title -}}
              {%- if section.settings.text_show_count -%}
                <sup class="subcollections__count">{{ sc.all_products_count }}</sup>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- else -%}
    {%- if sub_collections.size > 0 -%}
      {%- for sublink in sub_collections -%}
        {%- liquid
          if sublink.type != 'collection_link' or sublink.object.handle == blank
            continue
          endif

          assign sub_collection_handle = sublink.object.handle
          assign sub_collection_handle_separator = sub_collection_handle | append: ',' | prepend: ','
          assign sub_collection = collections[sub_collection_handle]

          if sublink.object.handle contains sub_collection_handle_separator
            continue
          endif
        -%}

        {%- capture sub_collection_html -%}
          {{ sub_collection_html }}

          <div class="grid-item subcollection__item" data-grid-item>
            <div class="subcollection__inner">
              <a class="subcollection__link" href="{{ sub_collection.url }}">
                <div class="subcollection__image">
                  {%- assign image = sub_collection.image -%}

                  {%- if section.settings.select_image == 'product' or image == blank -%}
                    {%- assign image = sub_collection.products.first.featured_media.preview_image -%}
                  {%- endif -%}

                  {%- capture sizes -%}
                    (min-width: 750px) (calc(100vw - 16px) / 3), calc(100vw - 32px)
                  {%- endcapture -%}

                  {%- render 'image' image: image, sizes: sizes, cover: true -%}
                </div>
                {%- unless is_minimal -%}
                  <div class="image-overlay-bottom"></div>
                {%- endunless -%}
                <div class="subcollection__text">
                  <p class="subcollection__title h4">{{ sub_collection.title }}</p>
                  {%- if sub_collection.description != '' and section.settings.subcollection_description -%}
                    <div class="subcollection__description">{{ sub_collection.description }}</div>
                  {%- endif -%}
                </div>
              </a>
            </div>
          </div>
        {%- endcapture -%}

        {%- assign sub_collection_counter = sub_collection_counter | plus: 1 -%}

        {%- if sub_collection_counter >= sub_collection_limit -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if sub_collection_html != '' -%}
        {%- liquid
          assign layout_slider = false
          if section.settings.subcollection_layout == 'slider' and sub_collection_counter > 4
            assign layout_slider = true
          endif

          assign columns_desktop = sub_collection_counter | at_most: 4
          assign columns_medium = 3

          if columns_desktop == 2 or columns_desktop == 4
            assign columns_medium = 2
          endif
        -%}

        {%- capture sub_collection_html -%}
          <div class="grid{% if layout_slider %} grid--slider{% endif %} grid--mobile-slider"{% if layout_slider %} data-grid-slider{% endif %} style="--COLUMNS: {{ columns_desktop }}; --COLUMNS-MEDIUM: {{ columns_medium }};">
            {{ sub_collection_html }}
          </div>
        {%- endcapture -%}

        <div class="grid-outer">
          {%- if layout_slider -%}
            <grid-slider>
              {{ sub_collection_html }}
            </grid-slider>
          {%- else -%}
            {{ sub_collection_html }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Subcollections",
  "settings": [
    {
      "type": "paragraph",
      "content": "Create a [navigation list](/admin/content/menus) with the same name as this collection and link to other collections. [Learn more](https://broadcast.presidiocreative.com/collections/collection-pages/sub-collections)"
    },
    {
      "type": "select",
      "id": "subcollection_layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "overlay",
      "options": [
        {"value": "overlay", "label": "Title over image (default)"},
        {"value": "minimal", "label": "Square image, title below"},
        {"value": "text", "label": "Text tabs (no images)"}
      ],
      "info": "Square: title under the image. Text tabs: just links with the active one underlined."
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Card max width",
      "default": 220,
      "visible_if": "{{ section.settings.card_style == 'minimal' }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards / tabs",
      "default": 28,
      "visible_if": "{{ section.settings.card_style == 'minimal' or section.settings.card_style == 'text' }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Title / tab text size",
      "default": 14,
      "visible_if": "{{ section.settings.card_style == 'minimal' or section.settings.card_style == 'text' }}"
    },
    {
      "type": "header",
      "content": "Text tabs",
      "visible_if": "{{ section.settings.card_style == 'text' }}"
    },
    {
      "type": "select",
      "id": "tabs_alignment",
      "label": "Tab alignment",
      "default": "left",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "info": "Applies on desktop and mobile. Centered tabs switch to left-aligned automatically once there are too many to fit.",
      "visible_if": "{{ section.settings.card_style == 'text' }}"
    },
    {
      "type": "checkbox",
      "id": "text_show_count",
      "label": "Show product count (superscript)",
      "default": true,
      "visible_if": "{{ section.settings.card_style == 'text' }}"
    },
    {
      "type": "collection",
      "id": "text_all_collection",
      "label": "\"All\" tab collection",
      "info": "Optional. Adds an \"All\" tab (first) linking to this collection."
    },
    {
      "type": "text",
      "id": "text_all_label",
      "label": "\"All\" tab label",
      "default": "All",
      "visible_if": "{{ section.settings.card_style == 'text' }}"
    },
    {
      "type": "checkbox",
      "id": "subcollection_description",
      "label": "Show description",
      "default": false
    },
    {
      "type": "select",
      "id": "select_image",
      "label": "Select a photo to display",
      "options": [
        {
          "value": "collection",
          "label": "Collection image"
        },
        {
          "value": "product",
          "label": "Product image"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 20
    }
  ]
}
{% endschema %}
