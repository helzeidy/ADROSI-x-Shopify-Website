<!-- /sections/hubspot-form.liquid -->
{%- comment -%}
  A HubSpot form as a standalone section (e.g. for the Contact page): intro
  text, then either the form itself (Display: Form on the page) or a button
  that opens it in a popup. The popup is the shared snippet used by the
  product page's HubSpot block.
{%- endcomment -%}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign hs_ready = false
  if section.settings.portal_id != blank and section.settings.form_id != blank
    assign hs_ready = true
  endif
-%}

{{ 'hubspot-form-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hubspot-form-popup.js' | asset_url }}" defer="defer"></script>

<section
  id="HubspotSection--{{ section.id }}"
  class="hubspot-section section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="hubspot-form"
>
  {%- style -%}
    #HubspotSection--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;
    }
    #HubspotSection--{{ section.id }} .hubspot-section__inner {
      max-width: {{ section.settings.max_width }}px;
    }
  {%- endstyle -%}

  <div class="wrapper">
    <div class="hubspot-section__inner {{ section.settings.alignment }}">
      {%- if section.settings.subheading != blank -%}
        <p class="hubspot-section__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hubspot-section__heading {{ section.settings.heading_font_size }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hubspot-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if hs_ready and section.settings.display == 'popup' -%}
        <div class="hubspot-section__button">
          {%- render 'hubspot-form-popup', hs: section.settings, uid: section.id -%}
        </div>
      {%- elsif hs_ready -%}
        {%- comment -%}
          Form straight on the page. Same data attributes as the popup's
          <dialog>, so assets/hubspot-form-popup.js builds it the same way —
          just on load instead of on click.
        {%- endcomment -%}
        <div
          id="HubspotForm-{{ section.id }}"
          class="hubspot-popup__form hubspot-section__form"
          data-hubspot-inline
          data-portal-id="{{ section.settings.portal_id | strip | escape }}"
          data-form-id="{{ section.settings.form_id | strip | remove: 'hbspt-form-' | escape }}"
          data-region="{{ section.settings.region | default: 'na1' | escape }}"
          data-target="#HubspotForm-{{ section.id }}"
        >
          <p class="hubspot-popup__loading" data-hubspot-loading>Loading…</p>
        </div>
      {%- elsif request.design_mode -%}
        <p class="hubspot-section__notice">HubSpot form: add your Portal ID and Form ID in this section's settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HubSpot form",
  "tag": "section",
  "class": "section-hubspot-form",
  "disabled_on": {
    "groups": [
      "header",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        {
          "value": "heading-small",
          "label": "Small"
        },
        {
          "value": "heading-medium",
          "label": "Medium"
        },
        {
          "value": "heading-large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "text-center",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 320,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Form on the page"
        },
        {
          "value": "popup",
          "label": "Button that opens a popup"
        }
      ]
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Contact us",
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "header",
      "content": "HubSpot form"
    },
    {
      "type": "text",
      "id": "portal_id",
      "label": "Portal (Hub) ID",
      "info": "Your HubSpot account number. In HubSpot: click your account name, top right. Or copy portalId from the form's embed code."
    },
    {
      "type": "text",
      "id": "form_id",
      "label": "Form ID",
      "default": "a6bbe951-f3e6-4838-9cc8-2e245442c5c5",
      "info": "The formId from the embed code. Pasting the hbspt-form-… version also works."
    },
    {
      "type": "select",
      "id": "region",
      "label": "HubSpot region",
      "default": "na1",
      "info": "Use the region from the embed code. Most accounts are na1; EU data accounts are eu1.",
      "options": [
        {
          "value": "na1",
          "label": "na1 (North America)"
        },
        {
          "value": "na2",
          "label": "na2"
        },
        {
          "value": "na3",
          "label": "na3"
        },
        {
          "value": "eu1",
          "label": "eu1 (Europe)"
        },
        {
          "value": "ap1",
          "label": "ap1 (Asia Pacific)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Popup (popup display only)"
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Popup heading",
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "richtext",
      "id": "popup_text",
      "label": "Popup text",
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "header",
      "content": "Button (popup display only)"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Color",
      "default": "btn--primary",
      "options": [
        {
          "value": "btn--black",
          "label": "Black"
        },
        {
          "value": "btn--white",
          "label": "White"
        },
        {
          "value": "btn--primary",
          "label": "Primary"
        },
        {
          "value": "btn--secondary",
          "label": "Secondary"
        }
      ],
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "default": "btn--solid",
      "options": [
        {
          "value": "btn--solid",
          "label": "Solid"
        },
        {
          "value": "btn--outline",
          "label": "Outline"
        }
      ],
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "default": "btn--large",
      "options": [
        {
          "value": "btn--small",
          "label": "Small"
        },
        {
          "value": "",
          "label": "Medium"
        },
        {
          "value": "btn--large",
          "label": "Large"
        }
      ],
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false,
      "visible_if": "{{ section.settings.display == 'popup' }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "HubSpot form"
    }
  ]
}
{% endschema %}
