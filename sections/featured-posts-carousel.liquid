<!-- /sections/featured-posts-carousel.liquid -->

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign image_first = section.settings.image_position
-%}

{%- render 'stylesheet', name: 'featured-posts-carousel.css' -%}
<script src="{{ 'featured-posts-carousel.js' | asset_url }}" defer="defer"></script>

{%- if section.blocks.size > 0 -%}
  <section
    id="FeaturedPostsCarousel--{{ section.id }}"
    class="fpc section-padding {{ color_scheme }}{% if image_first == 'left' %} fpc--image-first{% endif %}"
    data-featured-posts-carousel
    data-section-id="{{ section.id }}"
    data-section-type="featured-posts-carousel"
  >
    {%- style -%}
      #FeaturedPostsCarousel--{{ section.id }} {
        --PT: {{ section.settings.padding_top }}px;
        --PB: {{ section.settings.padding_bottom }}px;
        --fpc-gap: {{ section.settings.slide_gap }}px;
        --fpc-peek: {{ section.settings.peek }}%;
        --fpc-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
        --fpc-image-height: {{ section.settings.image_height }}px;
        --fpc-image-height-mobile: {{ section.settings.image_height_mobile }}px;
        --fpc-card-padding: {{ section.settings.card_padding }}px;
        --fpc-header-gap: {{ section.settings.header_gap }}px;
        {%- if section.settings.card_bg != blank -%}
          --fpc-card-bg: {{ section.settings.card_bg }};
        {%- endif -%}
        {%- if section.settings.card_text != blank -%}
          --fpc-card-text: {{ section.settings.card_text }};
        {%- endif -%}
        {%- if section.settings.arrow_color != blank -%}
          --fpc-arrow-color: {{ section.settings.arrow_color }};
        {%- endif -%}
      }
    {%- endstyle -%}

    {%- if section.settings.background_image != blank -%}
      <div class="fpc__bg">
        {{
          section.settings.background_image
          | image_url: width: 2400
          | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: ''
        }}
        <div class="fpc__bg-overlay"></div>
      </div>
    {%- endif -%}

    <div class="fpc__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="fpc__header {{ section.settings.header_alignment }}">
          {%- if section.settings.subheading != blank -%}
            <p class="fpc__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="fpc__heading {{ section.settings.heading_font_size }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="fpc__viewport">
        {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
          <button
            type="button"
            class="fpc__arrow fpc__arrow--prev"
            data-fpc-prev
            aria-label="Previous"
          >
            {%- render 'icon-nav-arrow-left' -%}
          </button>
        {%- endif -%}

        <div class="fpc__track" data-fpc-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign post = block.settings.post
              assign post_image = block.settings.image | default: post.image
              assign post_url = post.url | default: block.settings.custom_url

              assign post_title = block.settings.title
              if post_title == blank
                assign post_title = post.title
              endif

              assign post_excerpt = block.settings.excerpt
              if post_excerpt == blank
                if post.excerpt != blank
                  assign post_excerpt = post.excerpt | strip_html
                else
                  assign post_excerpt = post.content | strip_html | truncatewords: 24
                endif
              endif

              assign post_tag = block.settings.subheading
              if post_tag == blank and post.tags.size > 0
                assign post_tag = post.tags.first
              endif
            -%}

            <div class="fpc__slide" data-fpc-slide {{ block.shopify_attributes }}>
              <div class="fpc__pair">
                <div class="fpc__card">
                  {%- if post_tag != blank -%}
                    <p class="fpc__tag">{{ post_tag }}</p>
                  {%- endif -%}

                  {%- if post_title != blank -%}
                    <h3 class="fpc__title {{ section.settings.title_font_size }}">
                      {%- if post_url != blank -%}
                        <a href="{{ post_url }}">{{ post_title }}</a>
                      {%- else -%}
                        {{ post_title }}
                      {%- endif -%}
                    </h3>
                  {%- endif -%}

                  {%- if section.settings.show_excerpt and post_excerpt != blank -%}
                    <p class="fpc__excerpt">{{ post_excerpt | truncatewords: 24 }}</p>
                  {%- endif -%}

                  {%- if section.settings.show_link and post_url != blank -%}
                    <a class="fpc__link" href="{{ post_url }}">
                      {{- section.settings.link_text | escape -}}
                      {%- render 'icon-nav-arrow-right' -%}
                    </a>
                  {%- endif -%}
                </div>

                <div class="fpc__image">
                  {%- if post_image != blank -%}
                    {%- if post_url != blank -%}<a href="{{ post_url }}">{%- endif -%}
                    {{
                      post_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '400, 600, 800, 1000, 1400',
                        sizes: '(min-width: 750px) 40vw, 90vw',
                        loading: 'lazy',
                        alt: post_title | escape
                    }}
                    {%- if post_url != blank -%}</a>{%- endif -%}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
          <button
            type="button"
            class="fpc__arrow fpc__arrow--next"
            data-fpc-next
            aria-label="Next"
          >
            {%- render 'icon-nav-arrow-right' -%}
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.show_dots and section.blocks.size > 1 -%}
        <div class="fpc__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="fpc__dot{% if forloop.first %} is-active{% endif %}"
              data-fpc-dot
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured posts carousel",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Article"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"},
        {"value": "heading-large", "label": "Large"}
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "text-center",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Sits behind the whole carousel. Leave empty to use the color scheme."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Background darken",
      "default": 40
    },
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        {"value": "left", "label": "Left of the text"},
        {"value": "right", "label": "Right of the text"}
      ]
    },
    {
      "type": "range",
      "id": "peek",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "%",
      "label": "Neighbour peek",
      "default": 12,
      "info": "How much of the next and previous slides shows at the edges."
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between slides",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 260,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Slide height",
      "default": 460
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 180,
      "max": 500,
      "step": 20,
      "unit": "px",
      "label": "Slide height (mobile)",
      "default": 260
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Text card padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "select",
      "id": "title_font_size",
      "label": "Post title size",
      "default": "heading-x-small",
      "options": [
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"}
      ]
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show \"Read more\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true,
      "info": "Hidden on mobile, where the carousel is swiped."
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrows and dots",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "article",
          "id": "post",
          "label": "Blog post"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Optional. Replaces the post's featured image."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Category label",
          "info": "Shown above the title. Defaults to the post's first tag."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt override"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Link override",
          "info": "Only needed when no blog post is selected above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured posts carousel",
      "blocks": [{"type": "post"}, {"type": "post"}, {"type": "post"}]
    }
  ]
}
{% endschema %}
