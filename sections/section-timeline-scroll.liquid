<!-- /sections/section-timeline-scroll.liquid -->

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign show_images = section.settings.show_images
  assign steps = section.blocks.size
  if steps == 0
    assign steps = 1
  endif
-%}

{{ 'timeline-scroll.css' | asset_url | stylesheet_tag }}
<script src="{{ 'timeline-scroll.js' | asset_url }}" defer="defer"></script>

<section
  id="TimelineScroll--{{ section.id }}"
  class="tls{% unless show_images %} tls--no-images{% endunless %} section-padding {{ color_scheme }}"
  data-timeline-scroll
  data-section-id="{{ section.id }}"
  data-section-type="timeline-scroll"
>
  {%- style -%}
    #TimelineScroll--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;
      --tls-steps: {{ steps }};
      --tls-step-scroll: {{ section.settings.step_scroll }};
      --tls-gap: {{ section.settings.column_gap }}px;
    }
  {%- endstyle -%}

  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="{{ section.settings.width }}">
      <div class="tls__intro {{ section.settings.intro_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="tls__intro-title {{ section.settings.heading_font_size }}">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="tls__intro-text rte {{ section.settings.text_font_size }}">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="tls__track" data-tls-track>
    <div class="tls__viewport">
      <div class="{{ section.settings.width }}">
        <div class="tls__layout">
          <div class="tls__rail" data-tls-rail>
            <span class="tls__rail-line" aria-hidden="true"></span>
            <span class="tls__rail-fill" aria-hidden="true"></span>

            {%- for block in section.blocks -%}
              <button
                type="button"
                class="tls__dot{% if forloop.first %} is-active{% endif %}"
                data-tls-dot
                aria-label="{{ block.settings.title | default: block.settings.subheading | default: 'Step' | escape }}"
              ></button>
            {%- endfor -%}
          </div>

          <div class="tls__panels">
            {%- for block in section.blocks -%}
              <div
                class="tls__panel{% if forloop.first %} is-active{% endif %}"
                data-tls-panel
                {{ block.shopify_attributes }}
              >
                <div class="tls__content">
                  {%- if block.settings.subheading != blank -%}
                    <span class="tls__step">{{ block.settings.subheading | escape }}</span>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <h3 class="tls__title {{ block.settings.heading_font_size }}">
                      {{- block.settings.title | escape -}}
                    </h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="tls__text rte {{ block.settings.text_font_size }}">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button_text != blank -%}
                    <div class="tls__button">
                      <a
                        href="{{ block.settings.button_url | default: '#' }}"
                        class="btn {{ block.settings.button_style }} {{ block.settings.button_type }}"
                      >
                        {{- block.settings.button_text | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>

                {%- if show_images -%}
                  <div class="tls__figure">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 1600
                        | image_tag:
                          widths: '400, 600, 800, 1000, 1200, 1600',
                          sizes: '(min-width: 750px) 45vw, 100vw',
                          loading: 'lazy',
                          alt: block.settings.title | escape
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Timeline scroll",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "paragraph",
      "content": "On desktop the section pins while you scroll: one step is shown at a time. On mobile it becomes a simple stacked list."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"},
        {"value": "heading-large", "label": "Large"}
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Section text"
    },
    {
      "type": "select",
      "id": "text_font_size",
      "label": "Text size",
      "default": "body-medium",
      "options": [
        {"value": "body-x-small", "label": "Extra small"},
        {"value": "body-small", "label": "Small"},
        {"value": "body-medium", "label": "Medium"},
        {"value": "body-large", "label": "Large"}
      ]
    },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "Intro alignment",
      "default": "text-center",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show images",
      "default": true
    },
    {
      "type": "range",
      "id": "step_scroll",
      "min": 0.5,
      "max": 3,
      "step": 0.25,
      "unit": "x",
      "label": "Scroll length per step",
      "default": 1,
      "info": "How far you scroll before the next step becomes active."
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between text and image",
      "default": 56
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper", "label": "Normal"},
        {"value": "wrapper--narrow", "label": "Narrow"},
        {"value": "wrapper--full-padded", "label": "Full width padded"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Step label",
          "default": "Step 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Step heading"
        },
        {
          "type": "select",
          "id": "heading_font_size",
          "label": "Heading size",
          "default": "heading-medium",
          "options": [
            {"value": "heading-x-small", "label": "Extra small"},
            {"value": "heading-small", "label": "Small"},
            {"value": "heading-medium", "label": "Medium"},
            {"value": "heading-large", "label": "Large"}
          ]
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step of the process.</p>"
        },
        {
          "type": "select",
          "id": "text_font_size",
          "label": "Text size",
          "default": "body-medium",
          "options": [
            {"value": "body-x-small", "label": "Extra small"},
            {"value": "body-small", "label": "Small"},
            {"value": "body-medium", "label": "Medium"},
            {"value": "body-large", "label": "Large"}
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_type",
          "label": "Button color",
          "default": "btn--primary",
          "options": [
            {"value": "btn--black", "label": "Black"},
            {"value": "btn--white", "label": "White"},
            {"value": "btn--primary", "label": "Primary"},
            {"value": "btn--secondary", "label": "Secondary"}
          ]
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "btn--solid",
          "options": [
            {"value": "btn--solid", "label": "Solid"},
            {"value": "btn--outline", "label": "Outline"},
            {"value": "btn--text", "label": "Text"}
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline scroll",
      "blocks": [
        {"type": "step", "settings": {"subheading": "Step 1", "title": "Sourcing the leathers"}},
        {"type": "step", "settings": {"subheading": "Step 2", "title": "Pattern cutting"}},
        {"type": "step", "settings": {"subheading": "Step 3", "title": "Sewing and sole mounting"}}
      ]
    }
  ]
}
{% endschema %}
